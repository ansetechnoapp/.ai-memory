  "kevin_evaluation_engine": {
    "evaluation_criteria": {
      "task_completion_rate": {
        "weight": 0.25,
        "description": "Percentage of tasks completed successfully",
        "calculation": "completed_tasks / total_assigned_tasks"
      },
      "response_time": {
        "weight": 0.20,
        "description": "Average time to complete tasks",
        "target_threshold": 300000,
        "penalty_factor": 0.1
      },
      "quality_score": {
        "weight": 0.25,
        "description": "Quality of deliverables based on Kevin's assessment",
        "scale": "1-10",
        "factors": ["accuracy", "completeness", "innovation", "efficiency"]
      },
      "collaboration_effectiveness": {
        "weight": 0.15,
        "description": "How well agent works with other agents",
        "metrics": ["communication_clarity", "dependency_management", "conflict_resolution"]
      },
      "error_rate": {
        "weight": 0.15,
        "description": "Frequency of errors requiring intervention",
        "calculation": "errors / total_tasks",
        "penalty_multiplier": 2.0
      }
    },
    "performance_thresholds": {
      "excellent": {
        "min_score": 0.85,
        "priority_boost": 0.2,
        "delegation_preference": "high"
      },
      "good": {
        "min_score": 0.70,
        "priority_boost": 0.1,
        "delegation_preference": "medium"
      },
      "average": {
        "min_score": 0.55,
        "priority_boost": 0.0,
        "delegation_preference": "normal"
      },
      "below_average": {
        "min_score": 0.40,
        "priority_boost": -0.1,
        "delegation_preference": "low"
      },
      "poor": {
        "min_score": 0.0,
        "priority_boost": -0.2,
        "delegation_preference": "minimal"
      }
    }
  },
