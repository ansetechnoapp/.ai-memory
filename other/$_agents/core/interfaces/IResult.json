{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IResult Interface",
  "description": "Interface standardisée pour tous les résultats produits par les agents",
  "type": "object",
  "properties": {
    "result_info": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifiant unique du résultat",
          "pattern": "^result_[0-9]+_[a-zA-Z0-9_-]+$"
        },
        "task_id": {
          "type": "string",
          "description": "ID de la tâche associée"
        },
        "agent_id": {
          "type": "string",
          "description": "ID de l'agent qui a produit le résultat"
        },
        "status": {
          "type": "string",
          "enum": ["success", "partial_success", "failure", "error", "timeout"],
          "description": "Statut d'exécution"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp de création du résultat"
        },
        "execution_time": {
          "type": "number",
          "description": "Temps d'exécution en millisecondes"
        },
        "version": {
          "type": "string",
          "description": "Version du résultat (pour historique)"
        }
      },
      "required": ["id", "task_id", "agent_id", "status", "created_at"]
    },
    "output": {
      "type": "object",
      "properties": {
        "primary_content": {
          "type": "string",
          "description": "Contenu principal du résultat"
        },
        "format": {
          "type": "string",
          "enum": ["markdown", "json", "plain_text", "html", "xml"],
          "description": "Format du contenu principal"
        },
        "files_generated": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Chemin du fichier généré"
              },
              "type": {
                "type": "string",
                "enum": ["report", "code", "documentation", "config", "data"],
                "description": "Type de fichier"
              },
              "size": {
                "type": "integer",
                "description": "Taille en octets"
              },
              "checksum": {
                "type": "string",
                "description": "Checksum pour vérification d'intégrité"
              },
              "description": {
                "type": "string",
                "description": "Description du contenu du fichier"
              }
            },
            "required": ["path", "type"]
          },
          "description": "Liste des fichiers générés"
        },
        "data": {
          "type": "object",
          "description": "Données structurées additionnelles"
        },
        "summary": {
          "type": "string",
          "description": "Résumé exécutif du résultat"
        }
      },
      "required": ["primary_content", "format"]
    },
    "quality": {
      "type": "object",
      "properties": {
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Score de confiance (0-1)"
        },
        "completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Niveau de complétude (0-1)"
        },
        "accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Niveau de précision estimé (0-1)"
        },
        "validation_results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "description": "Règle de validation"
              },
              "passed": {
                "type": "boolean",
                "description": "Résultat de la validation"
              },
              "message": {
                "type": "string",
                "description": "Message explicatif"
              },
              "severity": {
                "type": "string",
                "enum": ["info", "warning", "error", "critical"]
              }
            },
            "required": ["rule", "passed"]
          },
          "description": "Résultats des validations"
        },
        "quality_gates_passed": {
          "type": "boolean",
          "description": "Tous les points de contrôle qualité sont-ils passés"
        }
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "cpu_usage": {
          "type": "number",
          "description": "Utilisation CPU en pourcentage"
        },
        "memory_usage": {
          "type": "number",
          "description": "Utilisation mémoire en MB"
        },
        "tokens_consumed": {
          "type": "integer",
          "description": "Nombre de tokens consommés"
        },
        "api_calls_made": {
          "type": "integer",
          "description": "Nombre d'appels API effectués"
        },
        "cache_hits": {
          "type": "integer",
          "description": "Nombre de hits de cache"
        },
        "cache_misses": {
          "type": "integer",
          "description": "Nombre de misses de cache"
        }
      }
    },
    "errors": {
      "type": "object",
      "properties": {
        "error_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre total d'erreurs"
        },
        "warnings_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Nombre total d'avertissements"
        },
        "error_details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Code d'erreur"
              },
              "message": {
                "type": "string",
                "description": "Message d'erreur"
              },
              "severity": {
                "type": "string",
                "enum": ["warning", "error", "critical", "fatal"]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "context": {
                "type": "object",
                "description": "Contexte additionnel de l'erreur"
              },
              "stack_trace": {
                "type": "string",
                "description": "Stack trace si disponible"
              },
              "resolution_suggestion": {
                "type": "string",
                "description": "Suggestion de résolution"
              }
            },
            "required": ["code", "message", "severity", "timestamp"]
          },
          "description": "Détails des erreurs rencontrées"
        },
        "recovery_actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Actions de récupération effectuées"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "input_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dépendances d'entrée utilisées"
        },
        "agent_collaborations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent_id": {
                "type": "string"
              },
              "interaction_type": {
                "type": "string",
                "enum": ["consultation", "delegation", "validation", "data_exchange"]
              },
              "duration": {
                "type": "number",
                "description": "Durée de l'interaction en ms"
              }
            },
            "required": ["agent_id", "interaction_type"]
          },
          "description": "Collaborations avec d'autres agents"
        },
        "external_resources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resource_type": {
                "type": "string",
                "enum": ["api", "database", "file", "web", "service"]
              },
              "resource_id": {
                "type": "string"
              },
              "access_count": {
                "type": "integer"
              }
            },
            "required": ["resource_type", "resource_id"]
          },
          "description": "Ressources externes utilisées"
        }
      }
    },
    "next_actions": {
      "type": "object",
      "properties": {
        "recommended_follow_ups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "description": "Action recommandée"
              },
              "priority": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "estimated_effort": {
                "type": "string",
                "description": "Effort estimé"
              },
              "responsible_agent": {
                "type": "string",
                "description": "Agent recommandé pour l'action"
              }
            },
            "required": ["action", "priority"]
          },
          "description": "Actions de suivi recommandées"
        },
        "blocking_issues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Problèmes bloquants identifiés"
        },
        "improvement_suggestions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Suggestions d'amélioration"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags pour catégorisation"
        },
        "category": {
          "type": "string",
          "description": "Catégorie du résultat"
        },
        "complexity_achieved": {
          "type": "string",
          "enum": ["simple", "medium", "complex", "expert"],
          "description": "Niveau de complexité atteint"
        },
        "actual_cost": {
          "type": "number",
          "description": "Coût réel (tokens, temps, etc.)"
        },
        "reusability_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Score de réutilisabilité (0-1)"
        },
        "custom_fields": {
          "type": "object",
          "description": "Champs personnalisés spécifiques au domaine"
        }
      }
    }
  },
  "required": ["result_info", "output"]
}